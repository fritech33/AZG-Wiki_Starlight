{
  "name": "shiki-twoslash-renderer",
  "type": "module",
  "version": "0.3.5",
  "private": false,
  "description": "A Shiki renderer for Twoslash based on web components",
  "author": {
    "name": "ocavue",
    "email": "ocavue@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/ocavue/shiki-twoslash-renderer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocavue/shiki-twoslash-renderer.git"
  },
  "bugs": "https://github.com/ocavue/shiki-twoslash-renderer/issues",
  "keywords": [
    "Shiki",
    "Twoslash",
    "TypeScript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./style.css": {
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aria-ui/core": "^0.2.1",
    "@aria-ui/elements": "^0.1.10",
    "@shikijs/twoslash": "^4.1.0",
    "@shikijs/types": "^4.1.0",
    "@types/hast": "^3.0.4",
    "twoslash": "^0.3.8"
  },
  "devDependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@ocavue/eslint-config": "^4.5.8",
    "@ocavue/tsconfig": "^0.7.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tsdown/css": "^0.22.0",
    "@types/node": "^22.19.13",
    "astro": "^6.3.7",
    "astro-theme-toggle": "^0.8.1",
    "diffable-html-snapshot": "^0.2.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "shiki": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "build": "pnpm run build:tsdown && pnpm run build:astro",
    "build:tsdown": "tsc -b && tsdown",
    "build:astro": "astro build",
    "dev": "astro dev",
    "lint": "eslint .",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "types": "./dist/index.d.ts"
}